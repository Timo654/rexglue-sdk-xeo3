# {{ names.snake_case }} - ReXGlue Recompiled Project
#
# SDK boilerplate lives in generated/rexglue.cmake.

cmake_minimum_required(VERSION 3.25)
project({{ names.snake_case }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

include(generated/rexglue.cmake)

# Generate Windows version resource dynamically

set(GENERATED_RC "${CMAKE_CURRENT_BINARY_DIR}/version.rc")
    file(WRITE "${GENERATED_RC}" "
#include <winres.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
BEGIN
    BLOCK \"StringFileInfo\"
    BEGIN
        BLOCK \"040904b0\"
        BEGIN
            VALUE \"FileDescription\", \"rexglue: {{ names.snake_case }}\"
        END
    END
    BLOCK \"VarFileInfo\"
    BEGIN
        VALUE \"Translation\", 0x0409, 1200
    END
END
")

add_library({{ names.snake_case }} SHARED)
target_sources({{ names.snake_case }} PRIVATE "${GENERATED_RC}")

target_compile_options({{ names.snake_case }} PRIVATE -mavx)

set_target_properties({{ names.snake_case }} PROPERTIES
    PREFIX ""
)

rexglue_setup_target({{ names.snake_case }})
if(REXGLUE_XEO3_OUTPUT_NAME)
  set_target_properties({{ names.snake_case }} PROPERTIES OUTPUT_NAME "${REXGLUE_XEO3_OUTPUT_NAME}")
endif()
